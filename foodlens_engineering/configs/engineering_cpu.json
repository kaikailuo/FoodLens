{
  "backend": "native",
  "task": "caption",
  "family": "A",
  "model": {
    "backbone": "tiny",
    "pretrained": false,
    "hidden": 16,
    "embedding": 16,
    "heads": 4,
    "layers": 1,
    "feedforward": 32,
    "dropout": 0.1,
    "frozen_backbone": true
  },
  "seed": 42,
  "device": "cpu",
  "precision": "fp32",
  "deterministic": true,
  "threads": 2,
  "epochs": 2,
  "batch_size": 2,
  "accumulation": 1,
  "lr": 0.0003,
  "weight_decay": 0.01,
  "layer4_lr_multiplier": 0.1,
  "unfreeze_layer4_epoch": null,
  "gradient_clip": 1.0,
  "scheduler_step": 5,
  "scheduler_gamma": 0.5,
  "patience": 5,
  "tolerance": 1e-06,
  "monitor": "val_loss",
  "max_tokens": 12,
  "max_items": 32,
  "loss_weights": [
    1.0,
    1.0,
    1.0
  ],
  "metrics": [],
  "method": "ce",
  "scst_weight": 0.5,
  "transfer": "visual_gru",
  "engineering": true,
  "updates_per_epoch": null
}